{
  "description": "agent-team guardrails: ask before destructive database commands that may not target a local database",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-destructive-db.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
